FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/TecnoMarket.Web/TecnoMarket.Web.csproj
RUN dotnet publish src/TecnoMarket.Web/TecnoMarket.Web.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:11.0
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
CMD ["sh", "-c", "dotnet TecnoMarket.Web.dll --urls http://0.0.0.0:${PORT:-8080}"]
