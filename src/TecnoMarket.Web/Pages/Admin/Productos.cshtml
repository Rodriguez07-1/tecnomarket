@page
@model TecnoMarket.Web.Pages.Admin.ProductosModel
@{
    ViewData["Title"] = "Administración";
    var cultura = CultureInfo.GetCultureInfo("es-NI");
}

<div class="tm-page-head">
    <div class="d-flex align-items-center gap-3">
        <span class="tm-page-icon">🛠️</span>
        <div>
            <h1>Administración</h1>
            <p>Aprobá publicaciones, revisá pedidos y consultá la analítica.</p>
        </div>
    </div>
    <a asp-page="/Admin/Analitica" class="btn btn-outline-success btn-sm">📊 Ver analítica</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (TempData["Error"] is string errorTemp)
{
    <div class="alert alert-warning">@errorTemp</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-warning">@Model.Error</div>
}

<div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
    <div class="col"><div class="tm-kpi"><span class="tm-kpi-icon">⏳</span><span class="tm-kpi-valor">@Model.Pendientes</span><span class="tm-kpi-label">Pendientes</span></div></div>
    <div class="col"><div class="tm-kpi"><span class="tm-kpi-icon">✅</span><span class="tm-kpi-valor">@Model.Disponibles</span><span class="tm-kpi-label">Disponibles</span></div></div>
    <div class="col"><div class="tm-kpi"><span class="tm-kpi-icon">📦</span><span class="tm-kpi-valor">@Model.Vendidos</span><span class="tm-kpi-label">Vendidos</span></div></div>
    <div class="col"><div class="tm-kpi"><span class="tm-kpi-icon">💵</span><span class="tm-kpi-valor">C$ @Model.Ventas.ToString("N2", cultura)</span><span class="tm-kpi-label">Ventas</span></div></div>
</div>

@if (Model.Pendientes > 0)
{
    <div class="card tm-panel mb-4" style="border-color:rgba(255,176,46,.55)">
        <div class="card-header" style="background:#fff8e9;color:#8a5b00">⏳ Publicaciones pendientes de aprobación</div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Producto</th><th>Categoría</th><th class="text-end">Precio</th><th>Vendedor</th><th>Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var producto in Model.Productos.Where(p => p.Estado == "Pendiente"))
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrWhiteSpace(producto.ImagenUrl) ? "/img/sin-imagen.svg" : producto.ImagenUrl)"
                                         alt="" style="width:48px;height:48px;object-fit:cover" class="rounded-3" />
                                    <div>
                                        <div class="fw-semibold small">@producto.Titulo</div>
                                        <div class="text-muted small">@producto.Condicion</div>
                                    </div>
                                </div>
                            </td>
                            <td class="small">@Model.NombreCategoria(producto.CategoriaId)</td>
                            <td class="text-end fw-bold small tm-precio">C$ @producto.PrecioCordobas.ToString("N2", cultura)</td>
                            <td class="small text-muted">@producto.VendedorId</td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    <form method="post" asp-page-handler="Aprobar" class="d-inline">
                                        <input type="hidden" name="id" value="@producto.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">Aprobar</button>
                                    </form>
                                    <form method="post" asp-page-handler="Rechazar" class="d-inline">
                                        <input type="hidden" name="id" value="@producto.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Rechazar</button>
                                    </form>
                                    <form method="post" asp-page-handler="Borrar" class="d-inline">
                                        <input type="hidden" name="id" value="@producto.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Borrar este producto?')">Borrar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card tm-panel mb-4">
    <div class="card-header">Todos los productos (@Model.Productos.Count)</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr><th>Producto</th><th>Categoría</th><th class="text-end">Precio</th><th class="text-end">Stock</th><th>Estado</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var producto in Model.Productos)
                {
                    <tr>
                        <td class="small fw-semibold">@producto.Titulo</td>
                        <td class="small text-muted">@Model.NombreCategoria(producto.CategoriaId)</td>
                        <td class="text-end small">C$ @producto.PrecioCordobas.ToString("N2", cultura)</td>
                        <td class="text-end small">@producto.Stock</td>
                        <td>
                            <span class="badge @(producto.Estado == "Disponible" ? "bg-success" : producto.Estado == "Pendiente" ? "bg-warning text-dark" : producto.Estado == "Rechazado" ? "bg-danger" : "bg-secondary")">
                                @producto.Estado
                            </span>
                        </td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Borrar" class="d-inline">
                                <input type="hidden" name="id" value="@producto.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Borrar este producto?')">Borrar</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Productos.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay productos.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card tm-panel">
    <div class="card-header">Pedidos (@Model.Pedidos.Count)</div>
    <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
            <thead>
                <tr><th>Producto</th><th class="text-end">Cant.</th><th class="text-end">Total</th><th>Estado</th><th>Fecha</th></tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model.Pedidos.Take(20))
                {
                    <tr>
                        <td class="small">@pedido.ProductoTitulo</td>
                        <td class="text-end small">@pedido.Cantidad</td>
                        <td class="text-end small fw-bold tm-precio">C$ @pedido.TotalCordobas.ToString("N2", cultura)</td>
                        <td><span class="badge bg-success">@pedido.Estado</span></td>
                        <td class="small text-muted">@pedido.FechaPedido</td>
                    </tr>
                }
                @if (Model.Pedidos.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No hay pedidos.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
