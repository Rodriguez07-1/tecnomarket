@page
@model CarritoModel
@{
    ViewData["Title"] = "Carrito";
    var cultura = CultureInfo.GetCultureInfo("es-NI");
}

<div class="tm-page-head">
    <div class="d-flex align-items-center gap-3">
        <span class="tm-page-icon">🛒</span>
        <div>
            <h1>Mi carrito</h1>
            <p>@Model.Articulos artículo(s) · precios en Córdobas</p>
        </div>
    </div>
    <a asp-page="/Index" class="btn btn-outline-success btn-sm">Seguir comprando</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (TempData["Error"] is string errorTemp)
{
    <div class="alert alert-warning">@errorTemp</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-warning">@Model.Error</div>
}

@if (Model.Items.Count == 0)
{
    <div class="tm-empty">
        <div class="tm-empty-icon">🛒</div>
        <h3>Tu carrito está vacío</h3>
        <p>Explorá el catálogo y agregá los productos que te gusten.</p>
        <a asp-page="/Index" class="btn btn-success">Explorar el catálogo</a>
    </div>
}
else
{
    <div class="card tm-panel mb-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Producto</th><th class="text-end">Precio</th><th class="text-center">Cantidad</th><th class="text-end">Subtotal</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrWhiteSpace(fila.Producto.ImagenUrl) ? "/img/sin-imagen.svg" : fila.Producto.ImagenUrl)"
                                         alt="" style="width:56px;height:56px;object-fit:cover" class="rounded-3" />
                                    <div>
                                        <div class="fw-semibold">@fila.Producto.Titulo</div>
                                        <div class="small text-muted">Stock: @fila.Producto.Stock · @fila.Producto.ModalidadEntrega</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-end">C$ @fila.Producto.PrecioCordobas.ToString("N2", cultura)</td>
                            <td class="text-center">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <form method="post" asp-page-handler="Cambiar" class="d-inline">
                                        <input type="hidden" name="id" value="@fila.Producto.Id" />
                                        <input type="hidden" name="delta" value="-1" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">−</button>
                                    </form>
                                    <span class="fw-bold px-1">@fila.Cantidad</span>
                                    <form method="post" asp-page-handler="Cambiar" class="d-inline">
                                        <input type="hidden" name="id" value="@fila.Producto.Id" />
                                        <input type="hidden" name="delta" value="1" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">+</button>
                                    </form>
                                </div>
                            </td>
                            <td class="text-end fw-bold tm-precio">C$ @fila.Subtotal.ToString("N2", cultura)</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Quitar" class="d-inline">
                                    <input type="hidden" name="id" value="@fila.Producto.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row g-3 align-items-center">
        <div class="col-md-4">
            <form method="post" asp-page-handler="Vaciar">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Vaciar carrito</button>
            </form>
        </div>
        <div class="col-md-8">
            <div class="card tm-panel">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <span class="tm-kpi-label mb-0">Total a pagar</span>
                        <span class="tm-precio d-block" style="font-size:1.7rem">C$ @Model.Total.ToString("N2", cultura)</span>
                    </div>
                    <form method="post" asp-page-handler="Confirmar">
                        <button type="submit" class="btn btn-success btn-lg">Confirmar compra</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
