@page
@model FavoritosModel
@{
    ViewData["Title"] = "Favoritos";
    var cultura = CultureInfo.GetCultureInfo("es-NI");
}

<div class="tm-page-head">
    <div class="d-flex align-items-center gap-3">
        <span class="tm-page-icon">❤️</span>
        <div>
            <h1>Mis favoritos</h1>
            <p>Productos que guardaste para ver después.</p>
        </div>
    </div>
    <a asp-page="/Index" class="btn btn-outline-success btn-sm">Seguir explorando</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-warning">@Model.Error</div>
}

@if (Model.Productos.Count == 0 && string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="tm-empty">
        <div class="tm-empty-icon">🤍</div>
        <h3>Todavía no guardaste productos</h3>
        <p>Entrá al detalle de uno y tocá <strong>Agregar a favoritos</strong>.</p>
        <a asp-page="/Index" class="btn btn-success">Explorar catálogo</a>
    </div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
    @foreach (var producto in Model.Productos)
    {
        <div class="col">
            <div class="card h-100 tm-card shadow-sm">
                <div class="tm-img-wrap">
                    <img class="card-img-top tm-img" src="@(string.IsNullOrWhiteSpace(producto.ImagenUrl) ? "/img/sin-imagen.svg" : producto.ImagenUrl)"
                         alt="@producto.Titulo" loading="lazy" />
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title h6">@producto.Titulo</h5>
                    <p class="tm-precio mb-3">C$ @producto.PrecioCordobas.ToString("N2", cultura)</p>
                    <div class="mt-auto d-flex gap-2">
                        <a asp-page="/Producto" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                        <form method="post" asp-page-handler="Quitar">
                            <input type="hidden" name="id" value="@producto.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
